{
  "manifest_version": 3,
  "name": "Claude Prism",
  "version": "1.0.0",
  "description": "Optical UI, Smoked Obsidian themes, damped-spring motion, smooth typing caret, 5-step ink streaming, prism rims, liquid context vial & pixel mascots for claude.ai.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "action": {
    "default_title": "Claude Prism — Optical UI",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "css": [
        "src/styles/prism.css"
      ],
      "js": [
        "src/core/config.js",
        "src/core/motion-engine.js",
        "src/core/theme-bridge.js",
        "src/effects/smooth-caret.js",
        "src/effects/ink-stream.js",
        "src/effects/prism-rim.js",
        "src/effects/ripple-backdrop.js",
        "src/effects/mascots.js",
        "src/ui/workbench.js",
        "src/ui/settings-panel.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
